# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/ipo_lockin

# Secret for signing session JWTs (>= 16 chars; generate with: openssl rand -hex 32)
AUTH_SECRET=

# Optional: passwords for the seeded demo users (defaults are dev-only)
SEED_ADMIN_PASSWORD=
SEED_ANALYST_PASSWORD=
SEED_VIEWER_PASSWORD=

# Optional: Redis for a BullMQ job queue if you scale sync out of process
REDIS_URL=

# Optional: LLM API key if you enable LLM-assisted document extraction
# (the LLM is only a structured-extraction layer; results are always
# validated deterministically and it is never the final authority)
LLM_API_KEY=
